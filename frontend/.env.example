# Required environment variables for the PPE Detection frontend
# Copy this file to .env and fill in your values.
# NOTE: This project uses Vite — variables must be prefixed with VITE_

# HTTP base URL for REST endpoints (health check, PPE config, alarm ACK)
VITE_BACKEND_URL=http://localhost:8000

# WebSocket endpoint for real-time detection frames
VITE_WS_URL=ws://localhost:8000/ws

# Model path: local directory containing OpenVINO models or path to best.pt
MODEL_PATH=best_openvino_model

# Target device for inference (AUTO, CPU, GPU, intel:gpu, dml:0)
MODEL_DEVICE=AUTO

# Bounded queue size for frame processing
FRAME_QUEUE_SIZE=10

# Timeout (in seconds) to wait for new frames in the queue
INFERENCE_TIMEOUT=0.5

# Thread pool workers for sequential inference execution (do not change for OpenVINO)
EXECUTOR_WORKERS=1

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to perform CORS requests
CORS_ALLOWED_ORIGINS=http://localhost:5173
